{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep, all
 ;; .cljc → portable to JVM / SCI / ClojureScript / GraalVM). Both live in
 ;; the kotoba-lang org of this workspace (kotoba wasm → clojurewasm →
 ;; ClojureScript → nbb runtime priority, CLAUDE.md).
 :deps {
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}
        ;; Statutory working-time limits (overtime / breaks / rest periods)
        ;; by jurisdiction. The governor recomputes from :worked-spans via
        ;; worklaw/check — the advisor's hours are never trusted, same
        ;; pattern as kintai (ADR-2607310400/0500) and isco-4313's labor
        ;; recomputation. Capability library wrapping convention per
        ;; ADR-2607310300 D8: this is a horizontal capability, not an
        ;; ISIC-coded sector business.
        io.github.kotoba-lang/worklaw
        {:local/root "../../kotoba-lang/worklaw"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  → drive the demo through one OperationActor
  :run {:main-opts ["-m" "staffing.sim"]}
  ;; clojure -M:dev:render-html [out-file]  → build-time operator console
  :render-html {:main-opts ["-m" "staffing.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis — clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
